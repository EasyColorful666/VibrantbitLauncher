<Application
    x:Class="VibrantbitLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    DispatcherUnhandledException="OnDispatcherUnhandledException"
    Exit="OnExit"
    Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 主题色资源必须在 MergedDictionaries 之前定义，才能覆盖 WPF-UI 默认值 -->
            <Color x:Key="SystemAccentColor">#FF0078D4</Color>
            <Color x:Key="SystemAccentColorPrimary">#FF0078D4</Color>
            <Color x:Key="SystemAccentColorSecondary">#FF0078D4</Color>
            <Color x:Key="SystemAccentColorTertiary">#FF0078D4</Color>
            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource SystemAccentColor}" Opacity="0.7" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource SystemAccentColor}" Opacity="0.5" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="White" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="White" Opacity="0.7" />
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- 项目自定义视觉规范：放最后，以便覆盖 WPF-UI 的默认值 -->
                <ResourceDictionary Source="Styles/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
