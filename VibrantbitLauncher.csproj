<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- 版本号唯一来源：启动日志横幅、设置页「关于」均从此读取 -->
    <Version>1.0.4.1</Version>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- 不包含运行时 -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 可选：剪裁未使用代码，FDD也支持 -->
  </PropertyGroup>

  <!-- 发布时单个文件（不含运行时），仅 Release 发布时生效 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="MinecraftLaunch" Version="4.0.7" />
    <PackageReference Include="MinecraftLaunch.Base" Version="1.1.19" />
    <PackageReference Include="MinecraftLaunch.Skin" Version="1.0.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Blank.jpg" />
    <None Remove="Assets\bg1.png" />
    <None Remove="Assets\bg2.png" />
    <None Remove="Assets\bg3.png" />
    <None Remove="Assets\bg4.png" />
    <None Remove="Assets\gravatar.png" />
    <None Remove="Assets\HarmonyOS_Sans_Black.ttf" />
    <None Remove="Assets\icon.ico" />
    <None Remove="Assets\wpfui-icon-256.png" />
    <None Remove="Assets\wpfui-icon-1024.png" />
    <None Remove="icon.ico" />
    <None Remove="Resources\Grass_Block.png" />
    <None Remove="Views\Pages\gravatar.png" />
    <None Remove="Views\Windows\bg1.png" />
    <None Remove="Views\Windows\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Blank.jpg" />
    <!-- 内置壁纸，供「设置 → 背景图」选择 -->
    <Resource Include="Assets\bg1.png" />
    <Resource Include="Assets\bg2.png" />
    <Resource Include="Assets\bg3.png" />
    <Resource Include="Assets\bg4.png" />
    <Resource Include="Assets\gravatar.png" />
    <Resource Include="Assets\steve.png" />
    <Resource Include="Assets\HarmonyOS_Sans_Black.ttf" />
    <Resource Include="gravatar.png" />
    <Resource Include="icon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Grass_Block.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Views\Pages\gravatar.png" />
    <Resource Include="Views\Windows\bg1.png" />
    <Resource Include="Views\Windows\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Pages\InstallPage.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
