<Page
    x:Class="VibrantbitLauncher.Views.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="64"
                Foreground="{DynamicResource SystemAccentColorBrush}"
                Symbol="Rocket24" />
            <TextBlock
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource DisplayText}"
                Text="欢迎使用 Vibrantbit Launcher" />
            <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryText}"
                Text="轻量、快速、现代的 Minecraft 启动器" />
            <ui:Button
                Margin="0,48,0,0"
                Padding="32,10"
                HorizontalAlignment="Center"
                Appearance="Primary"
                Click="NextButton_Click"
                Content="开始"
                Icon="{ui:SymbolIcon Symbol=ChevronRight24}" />
        </StackPanel>
    </Grid>
</Page>
