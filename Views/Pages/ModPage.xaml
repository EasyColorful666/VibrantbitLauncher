<Page
    x:Class="VibrantbitLauncher.Views.Pages.ModPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ModPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="0,0,95,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="41*" />
            <RowDefinition Height="409*" />
        </Grid.RowDefinitions>
        <ComboBox
            x:Name="comboBox"
            Width="150"
            Height="34"
            Margin="105,0,0,0"
            HorizontalAlignment="Left" />
        <TextBlock
            Width="57"
            Height="18"
            Margin="30,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="游戏版本"
            TextWrapping="Wrap" />

        <!--  加载中提示  -->
        <TextBlock
            x:Name="loadingText"
            Grid.Row="1"
            Width="0"
            Height="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Foreground="Gray"
            Text="正在加载模组文件..."
            Visibility="Collapsed" />

        <ListBox
            x:Name="listBox"
            d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,38,0,4" Grid.RowSpan="2">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Width="677" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MaxWidth="440" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,6,0,7"
                            Text="{Binding Name}" />

                        <Button
                            Grid.Column="2"
                            Width="66"
                            Height="31"
                            Margin="8,0,0,0"
                            Click="OnSaveAsClick"
                            Content="另存为" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ComboBox
            x:Name="comboBox1"
            Width="150"
            Height="34"
            Margin="382,2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" SelectionChanged="comboBox1_SelectionChanged" >
            <ComboBoxItem/>
            <ComboBoxItem Content="Fabric"/>
            <ComboBoxItem Content="Forge"/>
            <ComboBoxItem Content="NeoForge"/>
            <ComboBoxItem Content="Quilt"/>
        </ComboBox>
        <TextBlock
            Width="65"
            Height="18"
            Margin="299,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="模组加载器"
            TextWrapping="Wrap" />
    </Grid>
</Page>
