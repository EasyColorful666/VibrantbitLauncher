<Page
    x:Class="VibrantbitLauncher.Views.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DownloadPage"
    d:DataContext="{d:DesignInstance Type=local:DownloadPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <BitmapImage
                x:Key="GrassIcon"
                DecodePixelWidth="50"
                UriSource="/Assets/Grass_Block.png"
                CacheOption="OnLoad" />
        </Grid.Resources>
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Margin="0,0,140,0" />
        <ListBox
            x:Name="listBox"
            Margin="0,37,110,0"
            ScrollViewer.CanContentScroll="True"
            VirtualizingStackPanel.IsVirtualizing="True"
            VirtualizingStackPanel.VirtualizationMode="Recycling"
            VirtualizingStackPanel.CacheLength="20,0"
            VirtualizingStackPanel.CacheLengthUnit="Item">
            <ListBox.Background>
                <SolidColorBrush Color="LightGray" />
            </ListBox.Background>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <Image
                            Width="50"
                            Height="50"
                            Margin="0,0,10,0"
                            Source="{StaticResource GrassIcon}" />
                        <StackPanel Width="200">
                            <TextBlock FontWeight="Bold" Text="{Binding Version}" />
                            <TextBlock Foreground="Green" Text="{Binding Date}" />
                        </StackPanel>
                        <Button
                            Width="100"
                            Height="30"
                            Margin="190,0,0,0"
                            Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding Version}"
                            Content="下载" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ui:TextBox
            x:Name="textBox"
            Width="607"
            Height="26"
            Margin="9,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="16"
            RenderTransformOrigin="0.5,0.5"
            TextChanged="TextBox_TextChanged"
            TextWrapping="Wrap">
            <ui:TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform AngleY="0.095" />
                    <RotateTransform />
                    <TranslateTransform Y="0.498" />
                </TransformGroup>
            </ui:TextBox.RenderTransform>
            <ui:TextBox.Resources>
                <VisualBrush
                    x:Key="HelpBrush"
                    AlignmentX="Left"
                    Opacity="0.5"
                    Stretch="None"
                    TileMode="None">
                    <VisualBrush.Visual>
                        <TextBlock
                            Cursor=""
                            FontSize="16"
                            FontStyle="Italic"
                            Text="查找版本" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </ui:TextBox.Resources>
            <ui:TextBox.Style>
                <Style TargetType="TextBox">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Background" Value="{StaticResource HelpBrush}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Background" Value="{StaticResource HelpBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ui:TextBox.Style>
        </ui:TextBox>


    </Grid>
</Page>
