<Page
    x:Class="VibrantbitLauncher.Views.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:VibrantbitLauncher.Helpers"
    xmlns:local="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DownloadPage"
    d:DataContext="{d:DesignInstance Type=local:DownloadPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="0,16,0,8">
        <Grid.Resources>
            <BitmapImage
                x:Key="GrassIcon"
                CacheOption="OnLoad"
                DecodePixelWidth="50"
                UriSource="/Assets/Grass_Block.png" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  搜索框：与下载中心其它页面保持一致的现代化样式（图标 + 占位文案）  -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox
                x:Name="textBox"
                Grid.Column="0"
                Height="36"
                VerticalContentAlignment="Center"
                Icon="{ui:SymbolIcon Symbol=Search24}"
                PlaceholderText="搜索游戏版本"
                TextChanged="TextBox_TextChanged" />

            <!--  右侧计数 / 提示：与资源浏览页的「显示前 N 条」呼应  -->
            <TextBlock
                x:Name="countText"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="共 0 个版本" />
        </Grid>

        <ListBox
            x:Name="listBox"
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            helpers:SmoothScrollBehavior.IsEnabled="True"
            ScrollViewer.CanContentScroll="False"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingStackPanel.CacheLength="20,0"
            VirtualizingStackPanel.CacheLengthUnit="Item"
            VirtualizingStackPanel.IsVirtualizing="True"
            VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                    <EventSetter Event="Loaded" Handler="VersionItem_Loaded" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--  整行可点击：点了直接进安装页（不再需要右侧「下载」按钮）  -->
                    <ui:Card
                        Padding="14,12"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnVersionCardClick"
                        Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  版本图标：圆角容器 + 马赛克块  -->
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource RadiusM}">
                                <Image
                                    Width="36"
                                    Height="36"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{StaticResource GrassIcon}" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource SubtitleText}"
                                    Text="{Binding Version}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    Style="{StaticResource CaptionText}"
                                    Text="{Binding Date}" />
                            </StackPanel>

                            <!--  右侧仅作视觉提示：进入箭头，不再放按钮  -->
                            <ui:SymbolIcon
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Symbol="ChevronRight24" />
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  空状态：搜索无结果时显示  -->
        <TextBlock
            x:Name="emptyText"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Style="{StaticResource SecondaryText}"
            Text="没有匹配的版本，换个关键词试试"
            Visibility="Collapsed" />

        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Grid.RowSpan="2"
            Panel.ZIndex="2" />
    </Grid>
</Page>
