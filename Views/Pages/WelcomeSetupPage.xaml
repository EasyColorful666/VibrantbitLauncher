<Page
    x:Class="VibrantbitLauncher.Views.Pages.WelcomeSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:VibrantbitLauncher.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    d:DataContext="{d:DesignInstance vm:SettingsPageViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="960"
    mc:Ignorable="d">
    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <!--  开机向导第 2 步：确认游戏目录、Java 与主题  -->
    <Grid Margin="{StaticResource PagePadding}" Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Style="{StaticResource DisplayText}" Text="快速设置" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource CaptionText}"
                Text="确认游戏目录和 Java 运行环境，之后随时能在「设置」里修改" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="640"
                HorizontalAlignment="Left">

                <!--  游戏目录  -->
                <TextBlock Style="{StaticResource SectionTitleText}" Text="游戏目录" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource CaptionText}"
                    Text="版本、存档和模组都会放在这个目录下" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Grid.Column="0"
                        IsReadOnly="True"
                        Text="{Binding MinecraftFolder, Mode=OneWay}"
                        ToolTip="{Binding MinecraftFolder}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="16,0"
                        Click="OnSelectFolder"
                        Content="选择" />
                </Grid>

                <!--  Java  -->
                <TextBlock
                    Margin="0,24,0,0"
                    Style="{StaticResource SectionTitleText}"
                    Text="Java 运行环境" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource CaptionText}"
                    Text="没有自动检测到 Java 时，可以手动指定 java.exe" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        ItemsSource="{Binding JavaEntries}"
                        SelectedItem="{Binding SelectedJava, Mode=TwoWay}"
                        ToolTip="{Binding SelectedJava.JavaPath}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource BodyText}"
                                        Text="{Binding JavaVersion}" />
                                    <TextBlock
                                        Margin="6,0"
                                        Style="{StaticResource SecondaryText}"
                                        Text="-" />
                                    <TextBlock
                                        Style="{StaticResource CaptionText}"
                                        Text="{Binding JavaPath}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="16,0"
                        Click="OnBrowseJava"
                        Content="浏览" />
                </Grid>

                <!--  主题  -->
                <TextBlock
                    Margin="0,24,0,0"
                    Style="{StaticResource SectionTitleText}"
                    Text="主题" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <RadioButton
                        Margin="0,0,16,0"
                        Command="{Binding ChangeThemeCommand}"
                        CommandParameter="theme_light"
                        Content="亮色"
                        GroupName="wizardTheme"
                        IsChecked="{Binding CurrentTheme, ConverterParameter=Light, Converter={StaticResource EnumToBooleanConverter}, Mode=OneWay}" />
                    <RadioButton
                        Command="{Binding ChangeThemeCommand}"
                        CommandParameter="theme_dark"
                        Content="暗色"
                        GroupName="wizardTheme"
                        IsChecked="{Binding CurrentTheme, ConverterParameter=Dark, Converter={StaticResource EnumToBooleanConverter}, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Margin="0,0,8,0"
                Padding="24,10"
                Click="OnBack"
                Content="上一步" />
            <ui:Button
                Padding="24,10"
                Appearance="Primary"
                Click="OnNext"
                Content="下一步"
                Icon="{ui:SymbolIcon Symbol=ChevronRight24}" />
        </StackPanel>
    </Grid>
</Page>
