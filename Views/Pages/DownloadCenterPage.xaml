<Page
    x:Class="VibrantbitLauncher.Views.Pages.DownloadCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:VibrantbitLauncher.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DownloadCenterPage"
    d:DataContext="{d:DesignInstance Type=local:DownloadCenterViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="{StaticResource PagePadding}" Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页面标题区：标题 + 右侧操作  -->
        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource DisplayText}" Text="下载任务" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource CaptionText}"
                    Text="查看安装与下载进度，或前往下载中心添加新任务" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Command="{Binding GoToVersionDownloadCommand}"
                    Content="下载游戏版本"
                    Icon="{ui:SymbolIcon Symbol=Globe24}" />
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Command="{Binding GoToModDownloadCommand}"
                    Content="下载模组资源"
                    Icon="{ui:SymbolIcon Symbol=Apps24}" />
                <ui:Button
                    Appearance="Secondary"
                    Command="{Binding ClearCompletedCommand}"
                    Content="清空已完成"
                    Icon="{ui:SymbolIcon Symbol=Delete24}" />
            </StackPanel>
        </Grid>

        <!--  空状态提示  -->
        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="暂无下载任务">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource SecondaryText}" TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ListBox
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Tasks}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:DownloadTaskItem}">
                    <ui:Card Padding="16,12" Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Padding="6,2"
                                        Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                        CornerRadius="{StaticResource RadiusS}">
                                        <TextBlock
                                            Style="{StaticResource CaptionText}"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            Text="{Binding TypeDisplay}" />
                                    </Border>
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SubtitleText}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <ProgressBar
                                    Margin="0,10,16,4"
                                    Height="6"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding Progress}" />

                                <Grid Margin="0,2,16,0">
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding StatusText}" />
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Style="{StaticResource CaptionText}"
                                            Text="{Binding Progress, StringFormat='{}{0}%'}" />
                                        <TextBlock
                                            Margin="12,0,0,0"
                                            Style="{StaticResource CaptionText}"
                                            Text="{Binding Speed}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!--  状态按钮  -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                                <ui:Button
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    Icon="{ui:SymbolIcon Symbol=ChevronRight24}">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button
                                    Width="32"
                                    Height="32"
                                    Appearance="Secondary"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    Icon="{ui:SymbolIcon Symbol=Dismiss24}">
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
