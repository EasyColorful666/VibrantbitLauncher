<Page
    x:Class="VibrantbitLauncher.Views.Pages.DownloadHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DownloadHubPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <!--  版式：左侧分类单选栏 + 右侧内容区  -->
    <Grid Margin="{StaticResource PagePadding}" Style="{StaticResource PageRoot}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox
            x:Name="CategoryList"
            Grid.Column="0"
            Margin="0,0,24,0"
            Background="Transparent"
            BorderThickness="0"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="CategoryList_SelectionChanged">

            <!--  分组标题：禁用项，不参与选中  -->
            <ListBoxItem IsEnabled="False">
                <TextBlock Style="{StaticResource CaptionText}" Text="游戏" />
            </ListBoxItem>

            <ListBoxItem IsSelected="True" Tag="0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Globe24" />
                    <TextBlock Margin="10,0,0,0" Text="原版游戏" />
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem IsEnabled="False">
                <TextBlock
                    Margin="0,14,0,0"
                    Style="{StaticResource CaptionText}"
                    Text="社区资源" />
            </ListBoxItem>

            <ListBoxItem Tag="1">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Apps24" />
                    <TextBlock Margin="10,0,0,0" Text="Mod" />
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="2">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="BoxMultiple24" />
                    <TextBlock Margin="10,0,0,0" Text="整合包" />
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="3">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ColorBackground24" />
                    <TextBlock Margin="10,0,0,0" Text="资源包" />
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="4">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="WeatherSunny24" />
                    <TextBlock Margin="10,0,0,0" Text="光影" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <!--
            两个 Frame 各自持有页面实例，切换时只改 Visibility。
            若给同一个 Frame.Content 反复赋值，WPF 会卸载/重建整棵视觉树，
            列表项、卡片、图片全部重新实例化，切一次要几百毫秒。
        -->
        <Grid x:Name="HostGrid" Grid.Column="1">
            <Frame
                x:Name="VersionFrame"
                JournalOwnership="OwnsJournal"
                NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</Page>
