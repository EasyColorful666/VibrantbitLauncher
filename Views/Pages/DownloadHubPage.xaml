<Page
    x:Class="VibrantbitLauncher.Views.Pages.DownloadHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DownloadHubPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <!--  版式：左侧分类单选栏 + 右侧内容区  -->
    <Grid Margin="{StaticResource PagePadding}" Style="{StaticResource PageRoot}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox
            x:Name="CategoryList"
            Grid.Column="0"
            Margin="0,0,24,0"
            Background="Transparent"
            BorderThickness="0"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectionChanged="CategoryList_SelectionChanged">

            <ListBox.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="Padding" Value="12,9" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>

            <!--
                原版游戏：把原来的「Minecraft」分组标题与「原版游戏」条合并成一条
                （分组标题本是不可选中的装饰项，合并后点一次就能进原版下载页）。
            -->
            <ListBoxItem IsSelected="True" Tag="0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Cube24" />
                    <TextBlock Margin="10,0,0,0" Text="Minecraft" />
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem IsEnabled="False" Padding="12,22,12,6">
                <TextBlock Style="{StaticResource CaptionText}" Text="社区资源" />
            </ListBoxItem>

            <ListBoxItem Tag="1">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Apps24" />
                    <TextBlock Margin="10,0,0,0" Text="模组" />
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="2">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="BoxMultiple24" />
                    <TextBlock Margin="10,0,0,0" Text="整合包" />
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="3">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Code24" />
                    <TextBlock Margin="10,0,0,0" Text="数据包" />
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="4">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Layer24" />
                    <TextBlock Margin="10,0,0,0" Text="资源包" />
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="5">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="WeatherSunny24" />
                    <TextBlock Margin="10,0,0,0" Text="光影" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <!--
            两个 Frame 各自持有页面实例，切换时只改 Visibility。
            若给同一个 Frame.Content 反复赋值，WPF 会卸载/重建整棵视觉树，
            列表项、卡片、图片全部重新实例化，切一次要几百毫秒。
        -->
        <Grid x:Name="HostGrid" Grid.Column="1">
            <Frame
                x:Name="VersionFrame"
                JournalOwnership="OwnsJournal"
                NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</Page>
