<Page
    x:Class="VibrantbitLauncher.Views.Pages.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RunPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="{StaticResource PagePadding}" Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页面标题区：标题 + 右侧操作  -->
        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource DisplayText}" Text="运行" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource CaptionText}"
                    Text="选择已安装的版本直接启动游戏" />
            </StackPanel>

            <ui:Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding RefreshCommand}"
                Content="刷新"
                Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
        </Grid>

        <ListBox
            x:Name="listBox"
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding MinecraftVersions}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            Margin="0,0,12,0"
                            Source="/Assets/Grass_Block.png" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleText}"
                            Text="{Binding Version}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />

                        <ui:Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding RunCommand}"
                            CommandParameter="{Binding Version}"
                            Content="运行" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding SettingsCommand}"
                            CommandParameter="{Binding Version}"
                            Content="设置" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Grid.RowSpan="2"
            Panel.ZIndex="2" />
    </Grid>
</Page>
