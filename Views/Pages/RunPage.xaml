<Page
    x:Class="VibrantbitLauncher.Views.Pages.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:local="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RunPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <ListBox
            x:Name="listBox"
            Margin="20,60,70,40"
            ItemsSource="{Binding MinecraftVersions}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListBox.Background>
                <SolidColorBrush Color="LightGray" />
            </ListBox.Background>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <VirtualizingStackPanel Margin="5" Orientation="Horizontal">
                        <!--  图片绑定  -->
                        <Image
                            Width="50"
                            Height="50"
                            Margin="0,0,10,0"
                            Source="/Resources/Grass_Block.png" />
                        <!--  文本信息  -->
                        <Grid Width="200">
                            <TextBlock
                                Width="200"
                                Height="27"
                                FontSize="18"
                                FontWeight="Bold"
                                Text="{Binding Version}"
                                TextAlignment="Center" />
                        </Grid>
                        <Button
                            Width="60"
                            Height="30"
                            Margin="200,0,0,0"
                            Command="{Binding RunCommand}"
                            CommandParameter="{Binding Version}"
                            Content="运行" />
                        <Button
                            Width="60"
                            Height="30"
                            Command="{Binding SettingsCommand}"
                            CommandParameter="{Binding Version}"
                            Content="设置" />
                    </VirtualizingStackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Margin="-10,0,0,0"
            Panel.ZIndex="2" />
        <Label
            Width="299"
            Height="23"
            Margin="91,401,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="18"
            Foreground="Black" />
        <ui:Button
            Width="60"
            Height="60"
            Margin="20,0,0,0"
            VerticalAlignment="Top"
            Command="{Binding RefreshCommand}"
            Icon="{ui:SymbolIcon FontSize=36,
                                 Symbol=ArrowSync24}"
            RenderTransformOrigin="0.173,-0.162" />
    </Grid>
</Page>
