<Page
    x:Class="VibrantbitLauncher.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DashboardPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Page.DataContext>
        <local:DashboardPageViewModel />
    </Page.DataContext>
    <Grid Height="450" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBox
            x:Name="textBox"
            Grid.Column="1"
            Width="780"
            Height="215"
            Margin="10,225,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AcceptsReturn="True"
            FontFamily="HarmonyOS Sans Black"
            IsReadOnly="True"
            Text="{Binding HardwareInformation}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Visible" />
        <ui:TextBlock
            Grid.Column="1"
            Width="255"
            Height="45"
            Margin="10,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontFamily="HarmonyOS Sans Black"
            FontSize="36"
            Text="Hi,欢迎回来~"
            TextWrapping="Wrap" />
        <ui:TextBlock
            x:Name="t2"
            Grid.Column="1"
            Margin="10,135,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontFamily="HarmonyOS Sans Black"
            FontSize="18"
            Text="内存占用率:"
            TextWrapping="Wrap" />
        <ProgressBar
            x:Name="p2"
            Grid.Column="1"
            Width="784"
            Height="26"
            Margin="6,177,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
        <TextBlock x:Name="t1"
            Grid.Column="1"
            Width="218"
            Height="22"
            Margin="10,80,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontFamily="HarmonyOS Sans Black"
            FontSize="18"
            RenderTransformOrigin="-0.254,0.197"
            Text="今天是 "
            TextWrapping="Wrap" />

    </Grid>
</Page>
