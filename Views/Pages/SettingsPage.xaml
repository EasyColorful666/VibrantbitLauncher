<Page
    x:Class="VibrantbitLauncher.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:VibrantbitLauncher.Helpers"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    Title="SettingsPage"
    d:DataContext="{d:DesignInstance vm:SettingsPageViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d" ScrollViewer.CanContentScroll="True">
    <Page.DataContext>
        <vm:SettingsPageViewModel />
    </Page.DataContext>
    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <Grid Margin="{StaticResource PagePadding}" Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页面标题  -->
        <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Style="{StaticResource DisplayText}" Text="设置" />
            <Border Margin="0,10,0,0" Style="{StaticResource AccentRule}" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource CaptionText}"
                Text="外观、游戏路径与 Java 运行环境" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左栏：分类  -->
            <ListBox
                x:Name="CategoryList"
                Grid.Column="0"
                Margin="0,0,24,0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionChanged="CategoryList_SelectionChanged">

                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem IsSelected="True" Tag="0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Home24" />
                        <TextBlock Margin="10,0,0,0" Text="主页" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PaintBrush24" />
                        <TextBlock Margin="10,0,0,0" Text="个性化" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="2">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" />
                        <TextBlock Margin="10,0,0,0" Text="其他" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!--
                右栏：三个面板叠放，切换时只改 Visibility。
                不给 Content 反复赋值 —— 那会卸载并重建整棵视觉树。
            -->
            <Grid x:Name="PanelHost" Grid.Column="1">

                <!--  ===== 主页：当前配置概览 + 快捷操作 =====  -->
                <ScrollViewer
                    x:Name="HomePanel"
                    Padding="0,0,8,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ui:Card
                            Margin="0,0,0,16"
                            Padding="20,16"
                            Style="{StaticResource SurfaceCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Margin="0,0,16,10"
                                    Style="{StaticResource BodyText}"
                                    Text="游戏目录" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,0,10"
                                    Style="{StaticResource CaptionText}"
                                    Text="{Binding MinecraftFolder}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,0,16,10"
                                    Style="{StaticResource BodyText}"
                                    Text="Java 版本" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,0,10"
                                    Style="{StaticResource CaptionText}"
                                    Text="{Binding SelectedJava.JavaVersion}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,0,16,10"
                                    Style="{StaticResource BodyText}"
                                    Text="Java 路径" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,0,10"
                                    Style="{StaticResource CaptionText}"
                                    Text="{Binding SelectedJava.JavaPath}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Grid.Row="3"
                                    Margin="0,0,16,10"
                                    Style="{StaticResource BodyText}"
                                    Text="当前主题" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource CaptionText}" TargetType="TextBlock">
                                            <Setter Property="Text" Value="亮色" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentTheme}" Value="Dark">
                                                    <Setter Property="Text" Value="暗色" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock
                                    Grid.Row="4"
                                    Margin="0,0,16,0"
                                    Style="{StaticResource BodyText}"
                                    Text="日志" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Style="{StaticResource CaptionText}"
                                    Text="{Binding LogSummary}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </ui:Card>

                        <ui:Card Padding="20,16" Style="{StaticResource SurfaceCard}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    Style="{StaticResource SectionTitleText}"
                                    Text="快捷操作" />
                                <WrapPanel Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Padding="16,8"
                                        Appearance="Secondary"
                                        Command="{Binding OpenGameFolderCommand}"
                                        Content="打开游戏目录"
                                        Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Padding="16,8"
                                        Appearance="Secondary"
                                        Command="{Binding OpenLogFolderCommand}"
                                        Content="打开日志目录"
                                        Icon="{ui:SymbolIcon Symbol=Folder24}" />
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Padding="16,8"
                                        Appearance="Secondary"
                                        Command="{Binding RefreshJavaCommand}"
                                        Content="重新检测 Java"
                                        Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!--  ===== 个性化 =====  -->
                <ScrollViewer
                    x:Name="PersonalizationPanel"
                    Padding="0,0,8,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                <StackPanel>
            <!--  ===== 个性化：明暗主题 / 主题色 / 渐变色 =====  -->
            <ui:Card
                Margin="0,0,0,16"
                Padding="20,16"
                Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        Style="{StaticResource SectionTitleText}"
                        Text="个性化" />

                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource BodyText}"
                        Text="明暗主题" />
                    <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                        <RadioButton
                            Margin="0,0,16,0"
                            Command="{Binding ChangeThemeCommand}"
                            CommandParameter="theme_light"
                            Content="亮色"
                            GroupName="themeSelect"
                            IsChecked="{Binding CurrentTheme, ConverterParameter=Light, Converter={StaticResource EnumToBooleanConverter}, Mode=OneWay}" />
                        <RadioButton
                            Command="{Binding ChangeThemeCommand}"
                            CommandParameter="theme_dark"
                            Content="暗色"
                            GroupName="themeSelect"
                            IsChecked="{Binding CurrentTheme, ConverterParameter=Dark, Converter={StaticResource EnumToBooleanConverter}, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource BodyText}"
                        Text="主题色" />
                    <ItemsControl Margin="0,0,0,20" ItemsSource="{Binding AccentPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,10,10"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    ToolTip="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Ring"
                                                Width="40"
                                                Height="40"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                CornerRadius="20">
                                                <Border
                                                    Width="28"
                                                    Height="28"
                                                    Background="{Binding SwatchBrush}"
                                                    CornerRadius="14" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAccentSelected}" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource BodyText}" Text="主题渐变色" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource CaptionText}"
                                Text="开启后，标题强调条等位置使用主色到终点色的渐变"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding UseAccentGradient, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Margin="0,0,0,16" Visibility="{Binding UseAccentGradient, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource BodyText}"
                            Text="渐变终点色" />
                        <ItemsControl ItemsSource="{Binding AccentPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="0,0,10,10"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.SelectGradientEndCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        ToolTip="{Binding Name}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="Ring"
                                                    Width="40"
                                                    Height="40"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    CornerRadius="20">
                                                    <Border
                                                        Width="28"
                                                        Height="28"
                                                        Background="{Binding GradientEndBrush}"
                                                        CornerRadius="14" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsGradientSelected}" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource CaptionText}"
                        Text="预览" />
                    <Border
                        Height="44"
                        Margin="0,0,0,20"
                        Background="{DynamicResource AppAccentGradientBrush}"
                        CornerRadius="{StaticResource RadiusM}" />

                    <ui:Button
                        HorizontalAlignment="Left"
                        Appearance="Secondary"
                        Command="{Binding ResetAppearanceCommand}"
                        Content="恢复默认外观" />
                </StackPanel>
            </ui:Card>

            <!--  ===== 背景图 =====  -->
            <ui:Card
                Margin="0,0,0,16"
                Padding="20,16"
                Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource SectionTitleText}"
                        Text="背景图" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding BackgroundImageDisplay}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource BodyText}"
                        Text="内置壁纸" />
                    <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Wallpapers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,10,10"
                                    Padding="0"
                                    Command="{Binding DataContext.PickWallpaperCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Name}">
                                    <StackPanel Width="104">
                                        <Image
                                            Height="58"
                                            Source="{Binding ImagePath}"
                                            Stretch="UniformToFill" />
                                        <TextBlock
                                            Margin="0,6,0,6"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource CaptionText}"
                                            Text="{Binding Name}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                        <ui:Button Click="OnChooseBackgroundImage" Content="选择本地图片" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ClearBackgroundCommand}"
                            Content="移除背景" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource BodyText}"
                        Text="不透明度" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="360" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            Grid.Column="0"
                            IsEnabled="{Binding HasBackgroundImage}"
                            Maximum="1"
                            Minimum="0.05"
                            TickFrequency="0.05"
                            Value="{Binding BackgroundImageOpacity, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding BackgroundImageOpacity, StringFormat={}{0:P0}}" />
                    </Grid>
                </StackPanel>
            </ui:Card>
                </StackPanel>
                </ScrollViewer>

                <!--  ===== 其他 =====  -->
                <ScrollViewer
                    x:Name="OtherPanel"
                    Padding="0,0,8,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                <StackPanel>
            <!--  ===== 游戏设置 =====  -->
            <ui:Card
                Margin="0,0,0,16"
                Padding="20,16"
                Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        Style="{StaticResource SectionTitleText}"
                        Text="游戏设置" />

                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource BodyText}"
                        Text="Minecraft 文件夹" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="560" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Grid.Column="0"
                            IsReadOnly="True"
                            Text="{Binding MinecraftFolder, Mode=OneWay}"
                            ToolTip="{Binding MinecraftFolder}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="16,0"
                            Click="OnSelectMinecraftFolder"
                            Content="选择" />
                    </Grid>

                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource BodyText}"
                        Text="Java 版本" />
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="560" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            ItemsSource="{Binding JavaEntries}"
                            SelectedItem="{Binding SelectedJava, Mode=TwoWay}"
                            ToolTip="{Binding SelectedJava.JavaPath}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource BodyText}"
                                            Text="{Binding JavaVersion}" />
                                        <TextBlock
                                            Margin="6,0"
                                            Style="{StaticResource SecondaryText}"
                                            Text="-" />
                                        <TextBlock
                                            Style="{StaticResource CaptionText}"
                                            Text="{Binding JavaPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="16,0"
                            Command="{Binding RefreshJavaCommand}"
                            Content="刷新" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  ===== 日志 =====  -->
            <ui:Card
                Margin="0,0,0,16"
                Padding="20,16"
                Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource SectionTitleText}"
                        Text="日志" />
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource CaptionText}"
                        Text="启动失败、下载出错时，把等级调到「调试」再复现一次，然后导出日志即可提供给开发者定位。"
                        TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource BodyText}" Text="记录等级" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource CaptionText}"
                                Text="等级越低越详细；日常使用保持「信息」即可"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="180"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding LogLevels}"
                            SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource BodyText}" Text="保留天数" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource CaptionText}"
                                Text="超期的日志文件会自动清理"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="180"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding LogRetentionOptions}"
                            SelectedItem="{Binding SelectedLogRetention, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0} 天}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource BodyText}" Text="输出到调试器" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource CaptionText}"
                                Text="同时在 Visual Studio 输出窗口显示（仅调试版有效）"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding LogToDebugOutput, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource BodyText}"
                        Text="日志目录" />
                    <ui:TextBox
                        IsReadOnly="True"
                        Text="{Binding LogDirectory, Mode=OneWay}"
                        ToolTip="{Binding LogDirectory}" />
                    <StackPanel Margin="0,8,0,4" Orientation="Horizontal">
                        <ui:Button Command="{Binding OpenLogFolderCommand}" Content="打开日志目录" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Click="OnExportLog"
                            Content="导出日志" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ClearLogsCommand}"
                            Content="清空日志" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,16"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding LogActionMessage}"
                        TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource BodyText}" Text="最近日志" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource CaptionText}"
                                Text="{Binding LogSummary}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="140"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding LogFilters}"
                            SelectedItem="{Binding SelectedLogFilter, Mode=TwoWay}" />
                    </Grid>

                    <Border
                        Margin="0,6,0,0"
                        Padding="12,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="{StaticResource RadiusM}">
                        <ListBox
                            MaxHeight="260"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding RecentLogs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontFamily="Consolas"
                                            Style="{StaticResource CaptionText}"
                                            Text="{Binding TimeText}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            FontFamily="Consolas"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding LevelBrush}"
                                            Style="{StaticResource CaptionText}"
                                            Text="{Binding LevelText}" />
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Style="{StaticResource CaptionText}"
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                MaxHeight="80"
                                                Foreground="{Binding LevelBrush}"
                                                Style="{StaticResource CaptionText}"
                                                Text="{Binding ExceptionText}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasException, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!--  ===== 关于 =====  -->
            <ui:Card Padding="20,16" Style="{StaticResource SurfaceCard}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        Style="{StaticResource SectionTitleText}"
                        Text="关于 VibrantbitLauncher" />
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                        <Run Text="{Binding AppVersion, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="一款基于 WPF / .NET 的 Minecraft Java 版启动器：支持多账户登录、版本下载与启动、模组浏览与一键联机。" />
                    </TextBlock>

                    <TextBlock
                        Margin="0,24,0,12"
                        Style="{StaticResource SectionTitleText}"
                        Text="致谢" />
                    <TextBlock
                        Style="{StaticResource SecondaryText}"
                        Text="UI 参考 dream-pep；感谢 叶冷、3443**** 协助修复 bug。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
