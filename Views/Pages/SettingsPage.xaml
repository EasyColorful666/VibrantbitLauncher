<Page
    x:Class="VibrantbitLauncher.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:VibrantbitLauncher.Helpers"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    Title="SettingsPage"
    d:DataContext="{d:DesignInstance vm:SettingsPageViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    
    mc:Ignorable="d">
    <Page.DataContext>
        <vm:SettingsPageViewModel />
    </Page.DataContext>
    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <Grid>
        <TextBlock
            Margin="0,0,0,425"
            FontSize="20"
            FontWeight="Medium"
            Text="外观" />
        <TextBlock Margin="0,37,0,397"><Run Language="zh-cn" Text="主题" /></TextBlock>
        <!--  亮色主题单选按钮  -->
        <RadioButton
            Margin="0,65,0,0"
            VerticalAlignment="Top"
            Command="{Binding ChangeThemeCommand}"
            CommandParameter="theme_light"
            Content="亮色"
            GroupName="themeSelect"
            IsChecked="{Binding CurrentTheme, ConverterParameter=Light, Converter={StaticResource EnumToBooleanConverter}, Mode=OneWay}" />
        <!--  暗色主题单选按钮  -->
        <RadioButton
            Margin="0,105,0,0"
            VerticalAlignment="Top"
            Command="{Binding ChangeThemeCommand}"
            CommandParameter="theme_dark"
            Content="暗色"
            GroupName="themeSelect"
            IsChecked="{Binding CurrentTheme, ConverterParameter=Dark, Converter={StaticResource EnumToBooleanConverter}, Mode=OneWay}" />
        <TextBlock
            Margin="0,331,0,94"
            FontSize="20"
            FontWeight="Medium"><Run Language="zh-cn" Text="关于" /><Run Text=" VibrantbitLauncher" /></TextBlock>
        <ui:TextBlock
            x:Name="textBlock"
            Margin="0,356,0,27"
            TextWrapping="Wrap">
            <Run Text="Colorful craft launcher4是colorful craft launcher的新版, 更新了UI,更新了许多逻辑,修复了bug,更多功能敬请期待,如有改进意见,请联系" />
            <Run Text=" " />
            <Run Language="zh-cn" Text="chensiyuan" />
            <Run Text=" " />
            <Run Text="7788999" />
            <Run Text=" " />
            <Run Language="zh-cn" Text="@" />
            <Run Text=" " />
            <Run Text="163" />
            <Run Text=" " />
            <Run Language="zh-cn" Text="." />
            <Run Text=" " />
            <Run Text="com" />
            <Run Text=" " />
            <Run Language="zh-cn" Text="." />
            <LineBreak />
            <Run Language="zh-cn" />
            <LineBreak />
            <Run Language="zh-cn" Text="制作不易,敬请谅解!" />
        </ui:TextBlock>
        <TextBlock Margin="0,142,0,292" Text="背景" />
        <RadioButton
            x:Name="radioButton1"
            Margin="10,163,0,0"
            VerticalAlignment="Top"
            Content="背景1"
            GroupName="bg"
            IsChecked="True" />
        <RadioButton
            x:Name="radioButton2"
            Margin="10,195,0,0"
            VerticalAlignment="Top"
            Content="背景2"
            GroupName="bg" />
        <RadioButton
            x:Name="radioButton3"
            Margin="10,225,0,0"
            VerticalAlignment="Top"
            Content="背景3"
            GroupName="bg"
            IsChecked="False" />
        <RadioButton
            x:Name="radioButton4"
            Margin="10,257,0,0"
            VerticalAlignment="Top"
            Content="背景4"
            GroupName="bg" />
    </Grid>
</Page>
