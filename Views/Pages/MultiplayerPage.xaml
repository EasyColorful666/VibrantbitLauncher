<Page
    x:Class="VibrantbitLauncher.Views.Pages.MultiplayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="MultiplayerPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="{StaticResource PagePadding}" IsEnabled="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Style="{StaticResource DisplayText}" Text="多人" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{StaticResource CaptionText}"
                Text="通过 EasyTier 与好友组建虚拟局域网联机" />
        </StackPanel>

        <!--  房主  -->
        <ui:Card
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="16"
            Style="{StaticResource SurfaceCard}">
            <StackPanel>
                <RadioButton
                    x:Name="r1"
                    Checked="RadioButton_Checked"
                    Content="我要当房主"
                    GroupName="Mode"
                    IsChecked="False" />

                <Grid x:Name="grid1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="textBlock3"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyText}"
                        Text="密钥" />
                    <ui:TextBox
                        x:Name="textBox1"
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="textBlock1"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,12,12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyText}"
                        Text="本机虚拟IP" />
                    <ui:TextBox
                        x:Name="textBox3"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,12,0,0"
                        VerticalAlignment="Center"
                        IsReadOnly="True"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            x:Name="button"
                            MinWidth="160"
                            Click="button_Click"
                            Content="启动服务"
                            Icon="{ui:SymbolIcon Symbol=Play24}" />
                        <ui:Button
                            x:Name="button1"
                            MinWidth="160"
                            Margin="12,0,0,0"
                            Click="button1_Click"
                            Content="停止服务"
                            Icon="{ui:SymbolIcon Symbol=Stop24}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:Card>

        <!--  房客  -->
        <ui:Card
            Grid.Row="2"
            Margin="0,8,0,0"
            Padding="16"
            Style="{StaticResource SurfaceCard}">
            <StackPanel>
                <RadioButton
                    Checked="RadioButton_Checked_1"
                    Content="我要当房客"
                    GroupName="Mode" />

                <Grid x:Name="grid2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="textBlock3复制__C_"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyText}"
                        Text="密钥" />
                    <ui:TextBox
                        x:Name="textBox2"
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsReadOnly="True"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            x:Name="button2"
                            MinWidth="160"
                            Click="button2_Click"
                            Content="启动服务"
                            Icon="{ui:SymbolIcon Symbol=Play24}" />
                        <ui:Button
                            x:Name="button3"
                            MinWidth="160"
                            Margin="12,0,0,0"
                            Click="button1_Click"
                            Content="停止服务"
                            Icon="{ui:SymbolIcon Symbol=Stop24}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:Card>

        <!--  功能未完成，整页禁用；此提示覆盖在上方  -->
        <TextBlock
            Grid.RowSpan="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="3"
            FontFamily="{StaticResource AppDisplayFont}"
            FontSize="48"
            Text="敬请期待..."
            TextWrapping="Wrap" />

        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Grid.RowSpan="3"
            Panel.ZIndex="2"
            IsEnabled="False" />
    </Grid>
</Page>
