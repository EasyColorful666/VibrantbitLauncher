<Page
    x:Class="VibrantbitLauncher.Views.Pages.DownloadResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DownloadResourcesPage"
    d:DataContext="{d:DesignInstance Type=pages:DownloadResourcesViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.DataContext>
        <pages:DownloadResourcesViewModel />
    </Page.DataContext>
    <Grid>
        <ListBox
            x:Name="listBox"
            Margin="0,37,140,0"
            ItemsSource="{Binding ModrinthMods}"
            ScrollViewer.CanContentScroll="True"
            VirtualizingStackPanel.IsVirtualizing="True"
            VirtualizingStackPanel.VirtualizationMode="Recycling" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.Background>
                <SolidColorBrush Color="LightGray" />
            </ListBox.Background>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Width="50"
                            Height="50"
                            Margin="0,0,10,0"
                            Source="{Binding ImagePath}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                            <TextBlock Foreground="Green" Text="{Binding MinecraftVersions}" />
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Width="100"
                            Height="30"
                            Click="OnDownloadClick"
                            Content="下载" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 搜索框 -->
        <ui:TextBox
            x:Name="textBox"
            Width="360"
            Height="37"
            Margin="9,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="16"
            TextWrapping="Wrap">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="TextChanged">
                    <i:InvokeCommandAction Command="{Binding SerachCommand}" CommandParameter="{Binding ElementName=textBox, Path=Text}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <ui:TextBox.Resources>
                <VisualBrush
                    x:Key="HelpBrush"
                    AlignmentX="Left"
                    Opacity="0.5"
                    Stretch="None"
                    TileMode="None">
                    <VisualBrush.Visual>
                        <TextBlock FontSize="16" Text="搜索模组..." />
                    </VisualBrush.Visual>
                </VisualBrush>
            </ui:TextBox.Resources>
            <ui:TextBox.Style>
                <Style TargetType="TextBox">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Background" Value="{StaticResource HelpBrush}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Background" Value="{StaticResource HelpBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ui:TextBox.Style>
        </ui:TextBox>

        <!-- 版本筛选 -->
        <ComboBox
            x:Name="versionFilter"
            Width="110"
            Height="37"
            Margin="380,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ItemsSource="{Binding MinecraftVersions}"
            SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" />

        <!-- 加载器筛选 -->
        <ComboBox
            x:Name="loaderFilter"
            Width="110"
            Height="37"
            Margin="500,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ItemsSource="{Binding Loaders}"
            SelectedItem="{Binding SelectedLoader, Mode=TwoWay}" />

    </Grid>
</Page>
