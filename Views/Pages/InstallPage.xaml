<Page
    x:Class="VibrantbitLauncher.Views.Pages.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    Title="InstallPage"
    d:DataContext="{d:DesignInstance Type=local:InstallPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  四个加载器统一卡片外观，替代原生的朴素 Expander  -->
        <Style BasedOn="{StaticResource {x:Type Expander}}" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </Page.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding ElementName=SnackbarPresenter}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="{StaticResource PagePadding}" Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题与操作按钮  -->
        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Style="{StaticResource DisplayText}"
                Text="{Binding McVersion, StringFormat='安装版本 - {0}'}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ui:Button
                    Padding="24,10"
                    Command="{Binding InstallCommand}"
                    Content="安装"
                    Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                    IsEnabled="{Binding CanInstall}" />
                <ui:Button
                    Margin="10,0,0,0"
                    Padding="24,10"
                    Command="{Binding RefreshCommand}"
                    Content="刷新"
                    Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
            </StackPanel>
        </Grid>

        <!--  四个加载器：2x2 随窗口自适应  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Forge  -->
            <Expander
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,8,8"
                IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox
                            x:Name="checkBox1"
                            Checked="checkBox1_Checked"
                            Unchecked="checkBox1_Unchecked" />
                        <TextBlock Style="{StaticResource SubtitleText}" Text="Forge" />
                    </StackPanel>
                </Expander.Header>
                <ListBox
                    Padding="0,3,0,0"
                    ItemsSource="{Binding ForgeVersions}"
                    SelectedItem="{Binding SelectForgeVersion}" />
            </Expander>

            <!--  Fabric  -->
            <Expander
                Grid.Row="0"
                Grid.Column="1"
                Margin="8,0,0,8"
                IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox
                            x:Name="checkBox2"
                            Checked="checkBox2_Checked"
                            Unchecked="checkBox2_Unchecked" />
                        <TextBlock Style="{StaticResource SubtitleText}" Text="Fabric" />
                    </StackPanel>
                </Expander.Header>
                <ListBox ItemsSource="{Binding FabricVersions}" SelectedItem="{Binding SelectFabricVersion}" />
            </Expander>

            <!--  NeoForge  -->
            <Expander
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,8,8,0"
                IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox
                            x:Name="checkBox3"
                            Checked="checkBox3_Checked"
                            Unchecked="checkBox3_Unchecked" />
                        <TextBlock Style="{StaticResource SubtitleText}" Text="NeoForge" />
                    </StackPanel>
                </Expander.Header>
                <ListBox ItemsSource="{Binding NeoforgeVersions}" SelectedItem="{Binding SelectNeoforgeVersion}" />
            </Expander>

            <!--  Quilt  -->
            <Expander
                Grid.Row="1"
                Grid.Column="1"
                Margin="8,8,0,0"
                IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox
                            x:Name="checkBox4"
                            Checked="checkBox4_Checked"
                            Unchecked="checkBox4_Unchecked" />
                        <TextBlock Style="{StaticResource SubtitleText}" Text="Quilt" />
                    </StackPanel>
                </Expander.Header>
                <ListBox ItemsSource="{Binding QuiltVersions}" SelectedItem="{Binding SelectQuiltVersion}" />
            </Expander>
        </Grid>

        <!--  安装进度  -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                Grid.Column="0"
                Height="8"
                VerticalAlignment="Center"
                Value="{Binding InstallProgress}" />
            <StackPanel
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource SubtitleText}"
                    Text="{Binding InstallStep}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,2,0,0"
                    Style="{StaticResource CaptionText}"
                    Text="{Binding Speed}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Grid.RowSpan="3"
            Panel.ZIndex="2" />
    </Grid>
</Page>
