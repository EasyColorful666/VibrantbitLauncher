<Page
    x:Class="VibrantbitLauncher.Views.Pages.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:local="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    Title="InstallPage"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=local:InstallPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding ElementName=SnackbarPresenter}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Margin="0,0,85,0"
            Panel.ZIndex="2" />
        <TextBlock
            Margin="10,10,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontFamily="HarmonyOS Sans Black"
            FontSize="32"
            Text="{Binding McVersion, StringFormat='安装版本 - {0}'}"
            TextWrapping="Wrap" />

        <!--  Forge  -->
        <Expander
            Width="339"
            Height="153"
            Margin="5,67,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsExpanded="True">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        x:Name="checkBox1"
                        HorizontalAlignment="Left"
                        Checked="checkBox1_Checked"
                        FontSize="18"
                        Unchecked="checkBox1_Unchecked" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="18"
                        Text="Forge" />
                </StackPanel>
            </Expander.Header>
            <ListBox
                Padding="0,3,0,0"
                ItemsSource="{Binding ForgeVersions}"
                SelectedItem="{Binding SelectForgeVersion}" />
        </Expander>

        <!--  Fabric  -->
        <Expander
            Width="365"
            Height="153"
            Margin="350,67,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsExpanded="True"
            RenderTransformOrigin="0.5,0.5">
            <Expander.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform AngleX="-0.808" />
                    <RotateTransform />
                    <TranslateTransform X="-0.986" />
                </TransformGroup>
            </Expander.RenderTransform>
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        x:Name="checkBox2"
                        HorizontalAlignment="Left"
                        Checked="checkBox2_Checked"
                        FontSize="18"
                        Unchecked="checkBox2_Unchecked" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="18"
                        Text="Fabric" />
                </StackPanel>
            </Expander.Header>
            <ListBox ItemsSource="{Binding FabricVersions}" SelectedItem="{Binding SelectFabricVersion}" />
        </Expander>

        <!--  NeoForge  -->
        <Expander
            Width="339"
            Height="161"
            Margin="6,226,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsExpanded="True">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        x:Name="checkBox3"
                        HorizontalAlignment="Left"
                        Checked="checkBox3_Checked"
                        FontSize="18"
                        Unchecked="checkBox3_Unchecked" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="18"
                        Text="NeoForge" />
                </StackPanel>
            </Expander.Header>
            <ListBox ItemsSource="{Binding NeoforgeVersions}" SelectedItem="{Binding SelectNeoforgeVersion}" />
        </Expander>

        <!--  Quilt  -->
        <Expander
            Width="364"
            Height="161"
            Margin="351,226,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsExpanded="True">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        x:Name="checkBox4"
                        HorizontalAlignment="Left"
                        Checked="checkBox4_Checked"
                        FontSize="18"
                        Unchecked="checkBox4_Unchecked" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="18"
                        Text="Quilt" />
                </StackPanel>
            </Expander.Header>
            <ListBox ItemsSource="{Binding QuiltVersions}" SelectedItem="{Binding SelectQuiltVersion}" />
        </Expander>

        <StackPanel
            Margin="510,10,0,0"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:Button
                Width="140"
                Height="50"
                VerticalAlignment="Top"
                Command="{Binding InstallCommand}"
                Content="安装"
                IsEnabled="{Binding CanInstall}" />
            <ui:Button
                Width="60"
                Height="50"
                Margin="10,0,0,0"
                VerticalAlignment="Top"
                Command="{Binding RefreshCommand}"
                Content="刷新" />
        </StackPanel>
        <TextBlock
            Width="163"
            Height="22"
            Margin="552,394,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="22"
            FontWeight="Bold"
            Text="{Binding InstallStep}"
            TextWrapping="Wrap" />
        <ProgressBar
            Width="523"
            Height="14"
            Margin="10,408,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Value="{Binding InstallProgress}" />
        <TextBlock
            Width="163"
            Height="22"
            Margin="552,422,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="22"
            FontWeight="Bold"
            Text="{Binding Speed}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
