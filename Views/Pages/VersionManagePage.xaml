<Page
    x:Class="VibrantbitLauncher.Views.Pages.VersionManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    Title="VersionManagePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.DataContext>
        <vm:VersionManageViewModel />
    </Page.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding ElementName=SnackbarPresenter}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="{StaticResource PagePadding}" Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部：版本标题和返回按钮  -->
        <Grid Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button
                Grid.Column="0"
                VerticalAlignment="Center"
                Command="{Binding GoBackCommand}"
                Icon="{ui:SymbolIcon Symbol=ArrowLeft24}"
                ToolTip="返回运行页面" />
            <TextBlock
                Grid.Column="1"
                Margin="12,0,12,0"
                VerticalAlignment="Center"
                Style="{StaticResource TitleText}"
                Text="{Binding CurrentVersion}"
                TextTrimming="CharacterEllipsis" />
            <ui:Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{Binding RefreshCommand}"
                Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                ToolTip="刷新" />
        </Grid>

        <!--  标签切换：模组管理 / 存档管理  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,12"
            Orientation="Horizontal">
            <ui:Button
                x:Name="ModsTab"
                Margin="0,0,8,0"
                Padding="16,6"
                Click="ModsTab_Click"
                Content="模组管理"
                Icon="{ui:SymbolIcon Symbol=Apps24}" />
            <ui:Button
                x:Name="SavesTab"
                Margin="0,0,8,0"
                Padding="16,6"
                Click="SavesTab_Click"
                Content="存档管理"
                Icon="{ui:SymbolIcon Symbol=Folder24}" />
            <ui:Button
                Padding="16,6"
                Click="OpenFolder_Click"
                Content="打开游戏目录"
                Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
        </StackPanel>

        <!--  内容区域  -->
        <Grid Grid.Row="2">

            <!--  模组列表  -->
            <ListBox
                x:Name="ModsList"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Mods}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,6" Padding="14,10" Style="{StaticResource SurfaceCard}"><Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Grid.Column="0"
                                Margin="8,0,12,0"
                                VerticalAlignment="Center"
                                Checked="ModToggled"
                                IsChecked="{Binding IsEnabled}"
                                Unchecked="ModToggled" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyText}"
                                Text="{Binding FileName}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionText}"
                                Text="{Binding FileSize}" />
                            <ui:Button
                                Grid.Column="3"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Appearance="Secondary"
                                Command="{Binding DataContext.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding FolderPath}"
                                Content="打开" />
                            <ui:Button
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Appearance="Danger"
                                Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="删除" />
                        </Grid></ui:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  存档列表  -->
            <ListBox
                x:Name="SavesList"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Saves}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,6" Padding="14,10" Style="{StaticResource SurfaceCard}"><Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyText}"
                                Text="{Binding FolderName}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionText}"
                                Text="{Binding LastPlayed}" />
                            <ui:Button
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Appearance="Secondary"
                                Command="{Binding DataContext.OpenSaveFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding FolderPath}"
                                Content="打开" />
                            <ui:Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Appearance="Danger"
                                Command="{Binding DataContext.DeleteSaveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="删除" />
                        </Grid></ui:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  空状态提示  -->
            <TextBlock
                x:Name="EmptyHint"
                Margin="0,40,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryText}"
                Text="没有找到模组"
                Visibility="Collapsed" />
        </Grid>

        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Grid.RowSpan="3"
            Panel.ZIndex="2" />
    </Grid>
</Page>
