<Page
    x:Class="VibrantbitLauncher.Views.Pages.VersionManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Pages"
    xmlns:vm="clr-namespace:VibrantbitLauncher.ViewModels.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="VersionManagePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.DataContext>
        <vm:VersionManageViewModel />
    </Page.DataContext>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding ElementName=SnackbarPresenter}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：版本标题和返回按钮 -->
        <Grid Grid.Row="0" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button
                Grid.Column="0"
                Width="40"
                Height="40"
                Command="{Binding GoBackCommand}"
                Icon="{ui:SymbolIcon Symbol=ArrowLeft24}"
                ToolTip="返回运行页面" />
            <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="22"
                FontWeight="Bold"
                Text="{Binding CurrentVersion}" />
            <ui:Button
                Grid.Column="2"
                Width="40"
                Height="40"
                Command="{Binding RefreshCommand}"
                Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                ToolTip="刷新" />
        </Grid>

        <!-- 标签切换：模组管理 / 存档管理 -->
        <StackPanel
            Grid.Row="1"
            Margin="20,10,20,0"
            Orientation="Horizontal">
            <ui:Button
                x:Name="ModsTab"
                Width="120"
                Height="36"
                Margin="0,0,8,0"
                Click="ModsTab_Click"
                Content="模组管理" />
            <ui:Button
                x:Name="SavesTab"
                Width="120"
                Height="36"
                Margin="0,0,8,0"
                Click="SavesTab_Click"
                Content="存档管理" />
            <ui:Button
                Width="120"
                Height="36"
                Click="OpenFolder_Click"
                Content="打开游戏目录" />
        </StackPanel>

        <!-- 内容区域 -->
        <Grid Grid.Row="2" Margin="20,10,20,20">

            <!-- 模组列表 -->
            <ListBox
                x:Name="ModsList"
                ItemsSource="{Binding Mods}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="760" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                Margin="8,0,8,0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsEnabled}"
                                Checked="ModToggled"
                                Unchecked="ModToggled" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{Binding FileName}" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="10,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="Gray"
                                Text="{Binding FileSize}" />
                            <Button
                                Grid.Column="3"
                                Width="60"
                                Height="28"
                                Margin="0,0,8,0"
                                Command="{Binding DataContext.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding FolderPath}"
                                Content="打开" />
                            <Button
                                Grid.Column="4"
                                Width="60"
                                Height="28"
                                Background="#FFE81123"
                                Foreground="White"
                                Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="删除" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 存档列表 -->
            <ListBox
                x:Name="SavesList"
                Visibility="Collapsed"
                ItemsSource="{Binding Saves}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="760" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{Binding FolderName}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="Gray"
                                Text="{Binding LastPlayed}" />
                            <Button
                                Grid.Column="2"
                                Width="60"
                                Height="28"
                                Margin="0,0,8,0"
                                Command="{Binding DataContext.OpenSaveFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding FolderPath}"
                                Content="打开" />
                            <Button
                                Grid.Column="3"
                                Width="60"
                                Height="28"
                                Background="#FFE81123"
                                Foreground="White"
                                Command="{Binding DataContext.DeleteSaveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="删除" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态提示 -->
            <TextBlock
                x:Name="EmptyHint"
                Margin="0,40,0,0"
                HorizontalAlignment="Center"
                FontSize="16"
                Foreground="Gray"
                Text="没有找到模组"
                Visibility="Collapsed" />
        </Grid>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.RowSpan="3" Panel.ZIndex="2" />
    </Grid>
</Page>
