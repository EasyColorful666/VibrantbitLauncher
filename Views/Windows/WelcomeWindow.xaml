<ui:FluentWindow
    x:Class="VibrantbitLauncher.Views.Windows.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Vibrantbit Launcher"
    Width="960"
    Height="600"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    mc:Ignorable="d">
    <!--
        底色画在内容根节点上、并用 DynamicResource 引用主题画刷：
        WPF-UI 在切换明暗主题时会把窗口自身的 Background 写成「切换前的固定色刷」，
        之后不再更新（模态窗口尤其明显），暗色下就会变成浅色底 + 白字。
        放在自己的元素上就不受它影响，主题词典一换即自动跟随。
    -->
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Frame
            x:Name="MainFrame"
            NavigationUIVisibility="Hidden"
            JournalOwnership="OwnsJournal" />
    </Grid>
</ui:FluentWindow>
