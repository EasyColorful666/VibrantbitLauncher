<Window
    x:Class="VibrantbitLauncher.Views.Windows.CrashAnalysisWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="崩溃分析"
    Width="640"
    Height="480"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="#FFD13438" Margin="0,0,8,0" />
            <TextBlock FontSize="18" FontWeight="Bold" Text="Minecraft 崩溃分析" />
        </StackPanel>

        <!-- 说明 -->
        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            FontSize="12"
            Foreground="Gray"
            TextWrapping="Wrap"
            Text="游戏进程异常退出，以下是自动分析的崩溃原因和可疑模组：" />

        <!-- 崩溃原因 -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="12,10"
            Background="#FFFDF2F2"
            BorderBrush="#FFD13438"
            BorderThickness="1"
            CornerRadius="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="Warning24" Foreground="#FFD13438" Margin="0,0,6,0" />
                    <TextBlock FontWeight="SemiBold" Foreground="#FFD13438" Text="崩溃原因" />
                </StackPanel>
                <ListBox
                    x:Name="CrashReasonsList"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#FF333333"
                    FontSize="13"
                    Padding="0" />
            </DockPanel>
        </Border>

        <!-- 可疑模组 -->
        <Border
            Grid.Row="3"
            Margin="0,12,0,0"
            Padding="12,10"
            Background="#FFFFF8E6"
            BorderBrush="#FFFFA500"
            BorderThickness="1"
            CornerRadius="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="Apps24" Foreground="#FFFFA500" Margin="0,0,6,0" />
                    <TextBlock FontWeight="SemiBold" Foreground="#FFCC8800" Text="可疑模组" />
                </StackPanel>
                <ListBox
                    x:Name="SuspiciousModsList"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#FF333333"
                    FontSize="13"
                    Padding="0" />
            </DockPanel>
        </Border>

        <!-- 原始日志提示 -->
        <TextBlock
            Grid.Row="4"
            Margin="0,12,0,0"
            FontSize="11"
            Foreground="Gray"
            TextWrapping="Wrap"
            Text="详细日志请查看 .minecraft/crash-reports 目录下的崩溃报告文件。" />

        <!-- 按钮 -->
        <StackPanel
            Grid.Row="5"
            Margin="0,12,0,0"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                x:Name="OpenCrashFolderButton"
                Width="140"
                Height="32"
                Margin="0,0,10,0"
                Click="OpenCrashFolderButton_Click"
                Content="打开崩溃报告目录" />
            <Button
                x:Name="CloseButton"
                Width="90"
                Height="32"
                Background="#FF0078D4"
                Foreground="White"
                Click="CloseButton_Click"
                Content="关闭" />
        </StackPanel>
    </Grid>
</Window>
