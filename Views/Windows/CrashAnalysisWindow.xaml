<ui:FluentWindow
    x:Class="VibrantbitLauncher.Views.Windows.CrashAnalysisWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="崩溃分析"
    Width="640"
    Height="520"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{StaticResource AppFont}"
    FontSize="{StaticResource FontSizeBody}"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <!--  Fluent 窗口 + 自带标题栏，材质与配色随明暗主题自动切换  -->
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="崩溃分析"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题  -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <ui:SymbolIcon
                    Margin="0,0,8,0"
                    Foreground="{DynamicResource AppCriticalBrush}"
                    Symbol="ErrorCircle24" />
                <TextBlock Style="{StaticResource TitleText}" Text="Minecraft 崩溃分析" />
            </StackPanel>

            <!--  说明  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,8,0,0"
                Style="{StaticResource CaptionText}"
                Text="游戏进程异常退出，以下是自动分析的崩溃原因和可疑模组："
                TextWrapping="Wrap" />

            <!--  崩溃原因  -->
            <Border
                Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12,10"
                Background="{DynamicResource AppCriticalSurfaceBrush}"
                BorderBrush="{DynamicResource AppCriticalBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusM}">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Top"
                        Margin="0,0,0,8"
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,6,0"
                            Foreground="{DynamicResource AppCriticalBrush}"
                            Symbol="Warning24" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AppCriticalBrush}"
                            Text="崩溃原因" />
                    </StackPanel>
                    <ListBox
                        x:Name="CrashReasonsList"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="{StaticResource FontSizeBody}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </Border>

            <!--  可疑模组  -->
            <Border
                Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12,10"
                Background="{DynamicResource AppCautionSurfaceBrush}"
                BorderBrush="{DynamicResource AppCautionBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusM}">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Top"
                        Margin="0,0,0,8"
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,6,0"
                            Foreground="{DynamicResource AppCautionBrush}"
                            Symbol="Apps24" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AppCautionBrush}"
                            Text="可疑模组" />
                    </StackPanel>
                    <ListBox
                        x:Name="SuspiciousModsList"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="{StaticResource FontSizeBody}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </Border>

            <!--  原始日志提示  -->
            <TextBlock
                Grid.Row="4"
                Margin="0,12,0,0"
                Style="{StaticResource CaptionText}"
                Text="详细日志请查看 .minecraft/crash-reports 目录下的崩溃报告文件。"
                TextWrapping="Wrap" />

            <!--  按钮  -->
            <StackPanel
                Grid.Row="5"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="OpenCrashFolderButton"
                    Margin="0,0,10,0"
                    Padding="20,8"
                    Click="OpenCrashFolderButton_Click"
                    Content="打开崩溃报告目录" />
                <ui:Button
                    x:Name="CloseButton"
                    Padding="20,8"
                    Appearance="Primary"
                    Click="CloseButton_Click"
                    Content="关闭" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
