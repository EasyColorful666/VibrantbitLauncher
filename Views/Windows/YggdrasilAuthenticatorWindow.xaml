<Window
    x:Class="VibrantbitLauncher.Views.Windows.YggdrasilAuthenticatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="YggdrasilAuthenticatorWindow"
    Width="450"
    Height="260"
    mc:Ignorable="d">
    <Grid>
        <TextBlock
            Margin="33,51,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="服务器地址"
            TextWrapping="Wrap" />
        <TextBox
            Width="256"
            Margin="105,41,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="33,51,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="服务器地址"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="textBox1"
            Width="256"
            Margin="105,41,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="33,98,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="邮箱"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="textBox2"
            Width="256"
            Margin="105,88,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="33,141,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Text="密码"
            TextWrapping="Wrap" />
        <Button
            Width="309"
            Height="51"
            Margin="63,171,0,0"
            VerticalAlignment="Top"
            Click="Button_Click"
            Content="登录"
            Foreground="White">
            <Button.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
            </Button.Background>
        </Button>
        <PasswordBox
            x:Name="textBox3"
            Width="256"
            Height="32"
            Margin="105,133,89,0"
            VerticalAlignment="Top"
            Password="" />
    </Grid>
</Window>
