<ui:FluentWindow
    x:Class="VibrantbitLauncher.Views.Windows.YggdrasilAuthenticatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="添加外置账户"
    Width="460"
    Height="412"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{StaticResource AppFont}"
    FontSize="{StaticResource FontSizeBody}"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <!--  Fluent 窗口 + 自带标题栏，材质与配色随明暗主题自动切换  -->
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="添加外置账户"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="28,8,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Style="{StaticResource TitleText}"
                Text="添加外置账户" />
            <TextBlock
                Grid.Row="1"
                Margin="0,6,0,0"
                Style="{StaticResource SecondaryText}"
                Text="填入 Yggdrasil 认证服务器地址（如 LittleSkin）"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="2"
                Margin="0,20,0,6"
                Style="{StaticResource BodyText}"
                Text="服务器地址" />
            <ui:TextBox
                x:Name="textBox1"
                Grid.Row="3"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="4"
                Margin="0,14,0,6"
                Style="{StaticResource BodyText}"
                Text="邮箱" />
            <ui:TextBox
                x:Name="textBox2"
                Grid.Row="5"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="6"
                Margin="0,14,0,6"
                Style="{StaticResource BodyText}"
                Text="密码" />
            <ui:PasswordBox
                x:Name="textBox3"
                Grid.Row="7"
                Password="" />

            <StackPanel
                Grid.Row="9"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="96"
                    Padding="20,10"
                    Content="取消"
                    IsCancel="True" />
                <ui:Button
                    MinWidth="140"
                    Margin="10,0,0,0"
                    Padding="24,10"
                    Appearance="Primary"
                    Click="Button_Click"
                    Content="登录" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
