<Window
    x:Class="VibrantbitLauncher.Views.Windows.InstallEasyTierWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="安装联机模块"
    Width="400"
    Height="224"
    FontFamily="{StaticResource AppFont}"
    FontSize="{StaticResource FontSizeBody}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            Style="{StaticResource TitleText}"
            Text="安装联机模块" />

        <ProgressBar
            x:Name="progressBar"
            Grid.Row="1"
            Height="8"
            Margin="0,28,0,0" />

        <ui:Button
            x:Name="button1"
            Grid.Row="2"
            MinWidth="160"
            Margin="0,28,0,0"
            Padding="24,10"
            HorizontalAlignment="Center"
            Appearance="Primary"
            Click="Button_Click"
            Content="安装" />
    </Grid>
</Window>
