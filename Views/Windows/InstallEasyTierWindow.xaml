<ui:FluentWindow
    x:Class="VibrantbitLauncher.Views.Windows.InstallEasyTierWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="安装联机模块"
    Width="420"
    Height="268"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{StaticResource AppFont}"
    FontSize="{StaticResource FontSizeBody}"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <!--  Fluent 窗口 + 自带标题栏，材质与配色随明暗主题自动切换  -->
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="安装联机模块"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                HorizontalAlignment="Center"
                Style="{StaticResource TitleText}"
                Text="安装联机模块" />

            <TextBlock
                x:Name="statusText"
                Grid.Row="1"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="将从 GitHub 下载 EasyTier 核心（约 10 MB），解压到程序的 VBL 目录。"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <ProgressBar
                x:Name="progressBar"
                Grid.Row="2"
                Height="8"
                Margin="0,20,0,0" />

            <ui:Button
                x:Name="button1"
                Grid.Row="3"
                MinWidth="160"
                Margin="0,24,0,0"
                Padding="24,10"
                HorizontalAlignment="Center"
                Appearance="Primary"
                Click="Button_Click"
                Content="安装" />
        </Grid>
    </Grid>
</ui:FluentWindow>
