<ui:FluentWindow
    x:Class="VibrantbitLauncher.Views.Windows.OfflineAuthenticatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="添加离线账户"
    Width="360"
    Height="315"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{StaticResource AppFont}"
    FontSize="{StaticResource FontSizeBody}"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <!--
        用 ui:FluentWindow + 自带 TitleBar：
        · 窗口材质 / 圆角 / 标题栏按钮交给 WPF-UI，随明暗主题自动换色；
        · 内容底色用 DynamicResource 指向主题画刷，切主题即时跟随（不要写死颜色）。
    -->
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="添加离线账户"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                HorizontalAlignment="Center"
                Style="{StaticResource TitleText}"
                Text="添加离线账户" />

            <TextBlock
                Grid.Row="1"
                Margin="0,24,0,6"
                Style="{StaticResource BodyText}"
                Text="用户名" />

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:TextBox
                    x:Name="textBox1"
                    Grid.Row="0"
                    TextWrapping="Wrap" />
                <ui:Button
                    Grid.Row="1"
                    MinWidth="120"
                    Margin="0,20,0,0"
                    Padding="24,10"
                    HorizontalAlignment="Right"
                    Appearance="Primary"
                    Click="Button_Click"
                    Content="登录" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
