<ui:FluentWindow
    x:Class="VibrantbitLauncher.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:VibrantbitLauncher.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VibrantbitLauncher.ViewModels.Windows"
    Title="ColorfulCraftLauncher IV"
    Width="950"
    Height="600"
    Background="#3FFFFFFF"
    DataContext="{x:Type vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="HarmonyOS Sans Black"
    Icon="/Views/Windows/icon.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Padding="42,0,42,0"
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            PaneDisplayMode="LeftFluent">


            <ui:NavigationView.Header>
                <ui:BreadcrumbBar x:Name="BreadcrumbBar" Margin="42,32,42,20" />
            </ui:NavigationView.Header>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="主页 "
                    Icon="{ui:SymbolIcon Symbol=Home24,
                                         Filled=True}"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem
                    Content="账户 "
                    Icon="{ui:SymbolIcon Symbol=Person24,
                                         Filled=True}"
                    TargetPageType="{x:Type pages:AccountPage}" />
                <ui:NavigationViewItem
                    Content="下载 "
                    Icon="{ui:SymbolIcon Symbol=ArrowCircleDown24,
                                         Filled=True}"
                    TargetPageType="{x:Type pages:DownloadPage}" />
                <ui:NavigationViewItem
                    Content="运行"
                    Icon="{ui:SymbolIcon Symbol=TriangleRight20,
                                         Filled=True}"
                    TargetPageType="{x:Type pages:RunPage}" />
                <ui:NavigationViewItem
                    Content="多人"
                    Icon="{ui:SymbolIcon Symbol=PeopleCommunity24,
                                         Filled=True}"
                    TargetPageType="{x:Type pages:MultiplayerPage}" />

            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Background="#BFFFFFFF"
                    Content="设置"
                    Icon="{ui:SymbolIcon Symbol=Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>

        <ContentPresenter
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="2" />

        <ui:TitleBar
            x:Name="TitleBar"
            Title="VibrantbitLauncher"
            Grid.Row="0"
            Background="#7200D6FF"
            CloseWindowByDoubleClickOnIcon="True"
            ShowMaximize="False" FontSize="16" />
    </Grid>
</ui:FluentWindow>
