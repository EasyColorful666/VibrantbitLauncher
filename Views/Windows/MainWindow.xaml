<ui:FluentWindow
    x:Class="VibrantbitLauncher.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VibrantbitLauncher.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:VibrantbitLauncher.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VibrantbitLauncher.ViewModels.Windows"
    Title="VibrantbitLauncher"
    Width="1280"
    Height="800"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="{StaticResource AppWindowBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{StaticResource AppFont}"
    FontSize="{StaticResource FontSizeBody}"
    Icon="/Views/Windows/icon.ico"
    MinHeight="720"
    MinWidth="1180"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <!--  背景层：设置里选了壁纸才有内容，未设置时保持纯 Mica 底  -->
        <Image
            IsHitTestVisible="False"
            Opacity="{Binding ViewModel.BackgroundImageOpacity}"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="{Binding ViewModel.BackgroundImage}"
            Stretch="UniformToFill" />

        <!--  可读性遮罩：随明暗主题换色，半透明压在壁纸上；未设置壁纸时不显示  -->
        <Border Background="{DynamicResource AppBackgroundScrimBrush}" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.HasBackgroundImage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Background="Transparent"
            PaneDisplayMode="LeftFluent">

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="启动"
                    Icon="{ui:SymbolIcon Symbol=Play24}"
                    TargetPageType="{x:Type pages:LaunchPage}" />
                <ui:NavigationViewItem
                    Content="账户"
                    Icon="{ui:SymbolIcon Symbol=Person24}"
                    TargetPageType="{x:Type pages:AccountPage}" />
                <ui:NavigationViewItem
                    Content="下载中心"
                    Icon="{ui:SymbolIcon Symbol=ArrowCircleDown24}"
                    TargetPageType="{x:Type pages:DownloadHubPage}" />
                <ui:NavigationViewItem
                    Content="下载任务"
                    Icon="{ui:SymbolIcon Symbol=History24}"
                    TargetPageType="{x:Type pages:DownloadCenterPage}" />
                <ui:NavigationViewItem
                    Content="多人"
                    Icon="{ui:SymbolIcon Symbol=PeopleCommunity24}"
                    TargetPageType="{x:Type pages:MultiplayerPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="设置"
                    Icon="{ui:SymbolIcon Symbol=Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>

            <ui:TitleBar
                x:Name="TitleBar"
                Grid.Row="0"
                Title="VibrantbitLauncher"
                CloseWindowByDoubleClickOnIcon="True"
                FontSize="{StaticResource FontSizeBodyLarge}"
                ShowMaximize="True" />
        </Grid>
    </Grid>
</ui:FluentWindow>
